# ── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
CLIENT_URL=http://localhost:8081
ADMIN_URL=http://localhost:5173

# ── PostgreSQL ─────────────────────────────────────────
DATABASE_URL=postgres://mvradio:mvradio@localhost:5432/mvradio
DB_SSL=false

# ── JWT ────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Cloudinary ─────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Firebase Cloud Messaging ───────────────────────────
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE\n-----END PRIVATE KEY-----\n"

# ── Radio Stream (hosted by Stream-Africa — shared multi-station Icecast server) ──
# Plain HTTP on purpose: the provider's :8443 HTTPS listener serves an incomplete
# certificate chain (missing intermediate CA), which strict TLS clients reject. Port
# 8000 mirrors the same stream over plain HTTP, sidestepping that entirely.
DEFAULT_STREAM_URL=http://node.stream-africa.com:8000/ModernVoiceFM
ICECAST_STATUS_URL=http://node.stream-africa.com:8000/status-json.xsl
HLS_STREAM_URL=

# ── Rate limiting ──────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ── Google Maps (used by admin dashboard) ──────────────
GOOGLE_MAPS_API_KEY=your_google_maps_key
