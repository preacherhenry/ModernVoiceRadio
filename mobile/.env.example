# Expo inlines any EXPO_PUBLIC_* variable into the JS bundle at build time.
# Never put secrets here — this file ships inside the compiled app.

EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_SOCKET_URL=http://localhost:4000
EXPO_PUBLIC_DEFAULT_STREAM_URL=http://node.stream-africa.com:8000/ModernVoiceFM
EXPO_PUBLIC_HLS_STREAM_URL=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key
